{
    "logging": {
        "entity_name": "blabancz-university-of-edinburgh",
        "project_name": "two-dims"
    },

    "network_arguments": {
        "num_res_blocks": 1, 
        "input_size": 9, 
        "output_size": 9, 
        "in_channels": 6
    },

    "self_play": {
        "num_simulations": 30,
        "c": 1.25,
        "tau": 1,
        "early_selection_threshold": 5
    },

    "eval": {
        "num_games": 10,
        "num_simulations": 30,
        "c": 1.25,
        "win_rate_margin": 0.55,
        "minimax_max_depth": 3,
        "minimax_epsilon": 0
    },

    "training": {
        "batch_size": 16,
        "episodes_per_update": 4,
        "buffer_size": 1000,
        "checkpoint_frequency": 20,
        "lr": 0.01,
        "lr_annealing": 1e-1,
        "lr_annealing_step_size": 10000,
        "weight_decay": 1e-4,
        "momentum": 0.9,
        "save_path": "./checkpoints/two_b/"
    },

    "global": {
        "num_updates": 20000,
        "log_dir": "./logs/"
    }
}