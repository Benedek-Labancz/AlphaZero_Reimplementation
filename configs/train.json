{
    "network_arguments": {
        "num_res_blocks": 4, 
        "input_size": 9, 
        "output_size": 9, 
        "in_channels": 6
    },

    "self_play": {
        "num_simulations": 20,
        "c": 0.5,
        "tau": 1,
        "early_selection_threshold": 30
    },

    "eval": {
        "num_games": 10,
        "c": 0.5,
        "win_rate_margin": 0.55
    },

    "training": {
        "batch_size": 32,
        "buffer_size": 1000,
        "checkpoint_frequency": 10,
        "lr": 0.01,
        "lr_annealing": 1e-3,
        "weight_decay": 1e-4,
        "momentum": 0.9,
        "save_path": "./checkpoints/default/"
    },

    "global": {
        "num_games": 100
    }
}